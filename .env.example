# LiveStats - variaveis NAO secretas. Copie para .env (ignorado pelo Git) e preencha.
# Segredos NAO vao aqui: ficam em ./secrets/*.txt (ver secrets/README.md).

# --- Admin -----------------------------------------------------------------
# Usuario do painel administrativo. A senha nao fica aqui: so o hash, em secrets/admin_password_hash.txt.
ADMIN_USERNAME=troque-este-usuario

# URL publica (Cloudflare Tunnel), usada so para exibir os links no painel. Opcional.
PUBLIC_BASE_URL=https://live.exemplo.com

# Onde a porta 8081 (admin, HTTPS proprio, D33) escuta no host. 127.0.0.1 (padrao seguro) = so a propria maquina.
# No deploy use 0.0.0.0: quem filtra e a lista ADMIN_ALLOW_CIDRS abaixo. O certificado TLS e a chave ficam em
# secrets/admin_tls_cert.pem e secrets/admin_tls_key.pem (ver secrets/README.md); sem eles o web nao sobe.
ADMIN_BIND=127.0.0.1

# Lista de permissao do admin (8081): IPv4 ou IPv4/N (N de 8 a 32) separados por espaco; o resto recebe 403.
# Padrao 127.0.0.1/32. No deploy, por exemplo: 192.168.0.0/16 100.64.0.0/10
# 0.0.0.0/0, texto, IPv6 e bits de host preenchidos abortam a subida do web.
ADMIN_ALLOW_CIDRS=127.0.0.1/32

# --- Acesso externo ao painel (v4, D49) -------------------------------------
# 0 (padrao) = o painel (8081) so aceita a lista ADMIN_ALLOW_CIDRS acima.
# 1 = o painel pode ser aberto de fora pelo Nginx Proxy Manager (README, "Acessar o painel de fora da rede"): a lista de IPs
# deixa de valer (0.0.0.0/0 continua proibido nela), o IP do cliente vem do ultimo salto de X-Forwarded-For e o login
# fica limitado a 5 por minuto por IP. EXIGE ADMIN_TRUSTED_PROXY_IP: sem ele o web nao sobe.
ADMIN_EXTERNAL_ACCESS=0

# IP fixo (/32) do Nginx Proxy Manager na rede livestats-edge (ex.: 172.29.80.11). O deploy/connect_npm.sh o grava.
ADMIN_TRUSTED_PROXY_IP=

# Cabecalho de onde o painel le o IP do cliente (so vale vindo do proxy acima): X-Forwarded-For (padrao), CF-Connecting-IP
# (recomendado com o tunel do Cloudflare) ou X-Real-IP. Outro valor derruba o web na subida.
ADMIN_REAL_IP_HEADER=X-Forwarded-For

# Endereco externo do painel (ex.: https://painel.exemplo.com), mostrado na tela Conta. Opcional.
PUBLIC_ADMIN_URL=

# --- Usuarios e limites (v4, D48, D50) ---------------------------------------
# IPv4/CIDR (separados por espaco) de onde o MESTRE pode entrar e usar /api/admin/master/*. Vazio (padrao) = sem filtro.
MASTER_ALLOW_CIDRS=

# Tetos gerais de conjuntos e de lives somando todos os usuarios (a api os le).
MAX_SETS_TOTAL=200
MAX_LIVES_TOTAL=1000

# --- Rede de confianca no proxy -------------------------------------------
# Vazio (padrao) = nao confiar em ninguem: o cabecalho CF-Connecting-IP e sempre ignorado.
# Se o cloudflared estiver na rede livestats-edge, use SOMENTE o IP fixo dele em /32
# (ex.: 172.29.80.10/32). Nunca a sub-rede inteira nem o IP do gateway (.1).
TRUSTED_PROXY_CIDR=

# Sub-rede fixa da rede livestats-edge (onde o cloudflared recebe IP fixo).
EDGE_SUBNET=172.29.80.0/24
# IP fixo do web na rede edge: e o destino (Forward Hostname/IP) dos Proxy Hosts do NPM; o nome livestats-web nao resolve no nginx do NPM.
WEB_EDGE_IP=172.29.80.2

# --- Intervalos e diagnostico ----------------------------------------------
# Segundos entre leituras de cada live, cada uma no seu proprio ciclo e em paralelo (D42): de 5 a 15, padrao 10.
# Acima de 15 o worker-lives nao sobe (nenhuma live pode ficar mais de 15 s sem atualizar). O canal do YouTube nao se configura: o
# worker-inscritos o descobre pelos cookies (D38) e as lives vem das paginas publicas (D39).
LIVE_INTERVAL=10

# Historico dos graficos (D59): o LiveStats guarda a live inteira enquanto ha live ao vivo (resolucao completa por 24 h, depois 1 ponto
# por minuto) e apaga sessoes encerradas ha mais que isso. De 1 a 90 dias, padrao 14. Tambem e o maior periodo que o painel exporta em PNG.
HISTORY_RETENTION_DAYS=14

# 1 = o worker-lives usa Chromium so para o Kick quando o Cloudflare bloquear a consulta comum; 0 desliga.
KICK_BROWSER=1

# --- Chat unificado (D57, worker-chat) --------------------------------------
# Conexoes de chat (plataforma, canal) ao mesmo tempo, somando todos os conjuntos (padrao 30).
MAX_CHAT_LIVES_TOTAL=30
# Overlays (conexoes SSE) ao mesmo tempo; acima disso o overlay recebe 503 e tenta de novo (padrao 200).
MAX_CHAT_CLIENTS=200
# Abas do Chromium (uma por live do YouTube) ao mesmo tempo (padrao 6).
MAX_YT_CHAT_TABS=6

# Segundos entre leituras de inscritos (minimo 5).
SCRAPE_INTERVAL=10

# Reabre o Studio a cada N segundos (15 a 3600; 0 desliga). O contador da pagina nao mostra quedas sozinho.
STUDIO_RELOAD_INTERVAL=60

# Contadores de inscritos dos usuarios (D51): paginas do pool (0 desliga), segundos entre leituras de cada contador
# (30 a 3600) e maximo de contadores de usuario ativos. O contador do mestre nao depende destes valores.
USER_POOL_SIZE=1
USER_COUNTER_INTERVAL=60
MAX_USER_COUNTERS=20

# 1 grava print de depuracao em /tmp/debug dentro do container. Nunca vai para o volume de dados.
DEBUG_SCREENSHOT=0
