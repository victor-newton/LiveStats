# LiveStats - servidores publico (8080) e admin (8081).
# Renderizado pelo envsubst da imagem (/docker-entrypoint.d/20-envsubst-on-templates.sh) para
# /etc/nginx/conf.d/default.conf (tmpfs) na subida do container. Os marcadores LIVESTATS_REALIP_* sao
# calculados e VALIDADOS por /docker-entrypoint.d/15-livestats-realip.envsh a partir de TRUSTED_PROXY_CIDR (8080;
# vazio, o padrao => nenhuma diretiva real_ip) e ADMIN_ALLOW_CIDRS (8081, lista de permissao, marcador LIVESTATS_ADMIN_ALLOW).

# Com ADMIN_EXTERNAL_ACCESS=1 (D49) a lista nao se aplica (default 1, sem allow/deny) e o IP real vem do ultimo salto de
# X-Forwarded-For do proxy confiavel (LIVESTATS_REALIP_ADMIN); o login usa a zona login_ext (5/min).
# Lista de permissao da 8081 (D33), avaliada no REWRITE do server (antes de qualquer location): `allow/deny`
# so rodam na fase de acesso e nao alcancam locations que respondem com `return` (ex.: `location / { return 404; }`).
# O IP e o da CONEXAO ($remote_addr): a 8081 nao tem real_ip.
geo $remote_addr $livestats_admin_allowed {
    default ${LIVESTATS_ADMIN_GEO_DEFAULT};
    ${LIVESTATS_ADMIN_GEO}
}

# ----------------------------------------------------------------------------------------------------
# 8080 - PUBLICA (Cloudflare Tunnel aponta aqui). NAO existe nenhuma rota de admin: /, /admin,
# /admin-assets/, /api/admin/ e /api/admin/login caem em `location /` => 404.
# IP real: somente CF-Connecting-IP, e somente se a conexao vem do /32 de TRUSTED_PROXY_CIDR.
# ----------------------------------------------------------------------------------------------------
server {
    listen 8080 default_server;
    server_name _;

    ${LIVESTATS_REALIP_PUBLIC}

    include /etc/nginx/snippets/server_common.conf;
    include /etc/nginx/snippets/locations_public.conf;

    # Overlay do contador: so na publica. Na 8081 o caminho /contador e uma rota do painel (abaixo).
    location = /contador {
        limit_req zone=public burst=30 nodelay;
        default_type application/json;
        include /etc/nginx/snippets/static_headers_overlay.conf;
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405 '{"detail":"Method Not Allowed"}';
        }
        try_files /overlay/contador.html =404;
    }

    location / {
        return 404;
    }
}

# ----------------------------------------------------------------------------------------------------
# 8081 - ADMIN (D33): HTTPS PROPRIO (certificado autoassinado vindo de dois Docker secrets, montados so no web),
# lista de permissao ADMIN_ALLOW_CIDRS (padrao 127.0.0.1/32; o resto recebe 403 JSON) e NENHUM cabecalho de IP
# e confiavel (sem real_ip): o IP da conexao e o real. Sem HSTS, para nao prender o IP a um certificado.
# Tudo da publica + painel estatico + /api/admin/. HTTP simples nesta porta nunca chega a uma rota (400 JSON).
# ----------------------------------------------------------------------------------------------------
server {
    listen 8081 ssl default_server;
    server_name _;

    ${LIVESTATS_REALIP_ADMIN}

    ssl_certificate      /run/secrets/admin_tls_cert;
    ssl_certificate_key  /run/secrets/admin_tls_key;
    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_ciphers          ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers  off;
    ssl_session_tickets  off;
    ssl_session_cache    none;

    if ($livestats_admin_allowed = 0) {
        return 403;
    }
    ${LIVESTATS_ADMIN_ALLOW}
    ${LIVESTATS_ADMIN_DENY}

    # HTTP simples na porta TLS: 400 JSON (o 497 do Nginx e tratado como o 400 comum).
    error_page 497 =400 @e400;

    include /etc/nginx/snippets/server_common.conf;
    include /etc/nginx/snippets/locations_public.conf;

    # --- painel (estatico, cabecalhos estritos; os dados so vem de /api/admin/, que exige sessao)
    location = / {
        limit_req zone=public burst=30 nodelay;
        default_type application/json;
        include /etc/nginx/snippets/static_headers.conf;
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405 '{"detail":"Method Not Allowed"}';
        }
        try_files /admin-assets/index.html =404;
    }

    location ~ ^/admin/?$ {
        limit_req zone=public burst=30 nodelay;
        default_type application/json;
        include /etc/nginx/snippets/static_headers.conf;
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405 '{"detail":"Method Not Allowed"}';
        }
        try_files /admin-assets/index.html =404;
    }

    # Rotas do painel por caminho (History API): o MESMO index para uma lista branca exata, sem try_files generico;
    # qualquer outro caminho segue para `location /` (404). Os assets do HTML sao absolutos (/admin-assets/...).
    location ~ ^/(?:inicio|conjuntos|contador|saude|mestre|conta|conjuntos/[0-9]+)$ {
        limit_req zone=public burst=30 nodelay;
        default_type application/json;
        include /etc/nginx/snippets/static_headers.conf;
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405 '{"detail":"Method Not Allowed"}';
        }
        try_files /admin-assets/index.html =404;
    }

    # O painel v4 carrega ~35 arquivos (modulos JS, CSS, fontes) de uma vez a cada abertura: burst maior que o das
    # demais rotas, senao uma segunda abertura em 1-2 s (ou varias pessoas atras do mesmo IP) leva 429 num modulo e o painel nao sobe.
    location ^~ /admin-assets/ {
        limit_req zone=public burst=100 nodelay;
        default_type application/json;
        include /etc/nginx/snippets/static_headers.conf;
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405 '{"detail":"Method Not Allowed"}';
        }
        if ($uri ~ /$) {
            return 404;
        }
        try_files $uri =404;
    }

    # Sem a barra final o Nginx redirecionaria (301) para /api/admin/; aqui e 404.
    location = /api/admin {
        return 404;
    }

    # --- API de admin. Qualquer metodo comum chega a api, que decide: sem sessao => 401 (D30).
    location /api/admin/ {
        limit_req zone=admin burst=20 nodelay;
        default_type application/json;
        if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE)$) {
            return 405 '{"detail":"Method Not Allowed"}';
        }
        include /etc/nginx/snippets/admin_api_headers.conf;
        include /etc/nginx/snippets/proxy_api.conf;
    }

    # --- login: limite proprio, por IP real. Regex (e nao `location =`) para cobrir tambem
    # /api/admin/login/ e variantes com barras repetidas.
    location ~ ^/api/admin/login/*$ {
        limit_req ${LIVESTATS_ADMIN_LOGIN_LIMIT};
        default_type application/json;
        if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE)$) {
            return 405 '{"detail":"Method Not Allowed"}';
        }
        include /etc/nginx/snippets/admin_api_headers.conf;
        include /etc/nginx/snippets/proxy_api.conf;
    }

    location / {
        return 404;
    }
}
