#!/bin/sh
# LiveStats - IP real (ARCHITECTURE sec. 6, D29, D33).
#
# Arquivo `.envsh`: o entrypoint da imagem nginx-unprivileged o executa por `.` (source) ANTES de
# 20-envsubst-on-templates.sh, entao as variaveis exportadas aqui chegam ao envsubst que renderiza
# /etc/nginx/templates/default.conf.template. Precisa ter o bit de execucao (senao o entrypoint o ignora).
#
# Le TRUSTED_PROXY_CIDR (porta 8080: CF-Connecting-IP) e ADMIN_ALLOW_CIDRS (porta 8081: lista de permissao, D33;
# a 8081 nao confia em nenhum cabecalho de IP). Regras de TRUSTED_PROXY_CIDR (8080):
#   - vazio/ausente (padrao) => NENHUMA diretiva real_ip: o cabecalho e ignorado, vale o IP da conexao;
#   - preenchido => precisa ser UM unico IPv4, opcionalmente com /32. Qualquer outra coisa (sub-rede,
#     0.0.0.0/0, mascara diferente de /32, IPv6, texto qualquer, IP terminado em .1 = gateway da bridge,
#     .0, .255, 0.x.x.x, 127.x.x.x) ABORTA a subida do container com erro explicito.
# O gateway da bridge e a sub-rede inteira nunca podem ser confiaveis: conexoes pela porta publicada
# aparecem com o IP do gateway, e confiar nele deixaria qualquer cliente forjar o cabecalho (C2 do V0).

livestats_fail() {
    echo "15-livestats-realip: ERRO: $*" >&2
    exit 1
}

# livestats_proxy_ip <NOME_DA_VARIAVEL> <VALOR>
# Valida e deixa o IP normalizado (sem mascara) em LIVESTATS_IP; aborta se invalido.
livestats_proxy_ip() {
    _name=$1
    _val=$(printf '%s' "$2" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

    case $_val in
        */*)
            _mask=${_val#*/}
            _ip=${_val%%/*}
            [ "$_mask" = "32" ] || livestats_fail "$_name deve ser um unico IPv4 (/32); recebido mascara diferente de /32 (nunca a sub-rede)"
            ;;
        *)
            _ip=$_val
            ;;
    esac

    # exatamente 3 pontos
    case $_ip in
        *.*.*.*) ;;
        *) livestats_fail "$_name deve ser um IPv4 no formato A.B.C.D (IPv6 e texto nao sao aceitos)" ;;
    esac
    _o1=${_ip%%.*}; _r=${_ip#*.}
    _o2=${_r%%.*};  _r=${_r#*.}
    _o3=${_r%%.*};  _o4=${_r#*.}
    case $_o4 in
        *.*) livestats_fail "$_name deve ser um IPv4 no formato A.B.C.D" ;;
    esac

    for _o in "$_o1" "$_o2" "$_o3" "$_o4"; do
        case $_o in
            ''|*[!0-9]*) livestats_fail "$_name deve ser um IPv4 numerico no formato A.B.C.D" ;;
        esac
        case $_o in
            0?*) livestats_fail "$_name nao pode ter zeros a esquerda em um octeto" ;;
        esac
        [ "${#_o}" -le 3 ] && [ "$_o" -le 255 ] || livestats_fail "$_name tem octeto maior que 255"
    done

    [ "$_o1" != "0" ] || livestats_fail "$_name nao pode ser 0.x.x.x (0.0.0.0/0 confiaria em todo mundo)"
    [ "$_o1" != "127" ] || livestats_fail "$_name nao pode ser loopback"
    case $_o4 in
        0|1|255) livestats_fail "$_name nao pode terminar em .$_o4 (rede, gateway da bridge ou broadcast); use o IP fixo do proxy" ;;
    esac

    LIVESTATS_IP="$_o1.$_o2.$_o3.$_o4"
}

# --- porta 8080: CF-Connecting-IP, so do /32 do cloudflared
if [ -n "$(printf '%s' "${TRUSTED_PROXY_CIDR:-}" | tr -d '[:space:]')" ]; then
    livestats_proxy_ip TRUSTED_PROXY_CIDR "${TRUSTED_PROXY_CIDR}"
    LIVESTATS_REALIP_PUBLIC="real_ip_header CF-Connecting-IP; real_ip_recursive off; set_real_ip_from ${LIVESTATS_IP}/32;"
else
    LIVESTATS_REALIP_PUBLIC=""
fi

# --- porta 8081 (D33): NENHUM cabecalho de IP e confiavel; ha uma lista de permissao.
# ADMIN_ALLOW_CIDRS: lista separada por espaco de IPv4 ou IPv4/N (N de 8 a 32), padrao 127.0.0.1/32.
# Recusa (aborta a subida): vazio so de espacos e virgulas, 0.0.0.0/0 e qualquer prefixo menor que 8, 0.x.x.x,
# texto, IPv6, zeros a esquerda, octeto > 255, bits de host preenchidos (10.0.0.5/8) e caracteres que nao sejam
# digitos, ponto e barra (nada de ;, {, }, $, aspas ou quebra de linha chega ao Nginx).
livestats_cidr() {
    _name=$1
    _val=$2
    case $_val in
        */*)
            _ip=${_val%%/*}
            _mask=${_val#*/}
            ;;
        *)
            _ip=$_val
            _mask=32
            ;;
    esac
    case $_mask in
        ''|*[!0-9]*) livestats_fail "$_name: mascara invalida em '$_val' (use A.B.C.D ou A.B.C.D/N)" ;;
    esac
    case $_mask in
        0?*) livestats_fail "$_name: mascara com zero a esquerda em '$_val'" ;;
    esac
    { [ "$_mask" -ge 8 ] && [ "$_mask" -le 32 ]; } || livestats_fail "$_name: mascara /$_mask fora de 8..32 em '$_val' (nunca 0.0.0.0/0 nem redes enormes)"
    case $_ip in
        *.*.*.*) ;;
        *) livestats_fail "$_name: '$_val' nao e um IPv4 A.B.C.D (IPv6 e texto nao sao aceitos)" ;;
    esac
    _o1=${_ip%%.*}; _r=${_ip#*.}
    _o2=${_r%%.*};  _r=${_r#*.}
    _o3=${_r%%.*};  _o4=${_r#*.}
    case $_o4 in
        *.*) livestats_fail "$_name: '$_val' nao e um IPv4 A.B.C.D" ;;
    esac
    for _o in "$_o1" "$_o2" "$_o3" "$_o4"; do
        case $_o in
            ''|*[!0-9]*) livestats_fail "$_name: '$_val' nao e um IPv4 numerico" ;;
        esac
        case $_o in
            0?*) livestats_fail "$_name: '$_val' tem zero a esquerda em um octeto" ;;
        esac
        [ "${#_o}" -le 3 ] && [ "$_o" -le 255 ] || livestats_fail "$_name: '$_val' tem octeto maior que 255"
    done
    [ "$_o1" != "0" ] || livestats_fail "$_name: '$_val' comeca em 0 (0.0.0.0/0 liberaria todo mundo)"
    _n=$(( (_o1 << 24) + (_o2 << 16) + (_o3 << 8) + _o4 ))
    _host=$(( 32 - _mask ))
    if [ "$_host" -gt 0 ] && [ $(( _n & ((1 << _host) - 1) )) -ne 0 ]; then
        livestats_fail "$_name: '$_val' tem bits de host preenchidos; escreva o endereco de rede (ex.: 192.168.15.0/24)"
    fi
    LIVESTATS_CIDR="$_o1.$_o2.$_o3.$_o4/$_mask"
}

_allow_raw=${ADMIN_ALLOW_CIDRS-}
if [ -z "$(printf '%s' "$_allow_raw" | tr -d '[:space:]')" ]; then
    _allow_raw="127.0.0.1/32"
fi
# so digitos, ponto, barra e espacos em branco comuns (a quebra de linha e recusada abaixo)
case $_allow_raw in
    *[!0-9./' ']*) livestats_fail "ADMIN_ALLOW_CIDRS so aceita IPv4 e IPv4/N separados por espaco (recebido algo diferente disso)" ;;
esac
LIVESTATS_ADMIN_ALLOW=""
for _item in $_allow_raw; do
    livestats_cidr ADMIN_ALLOW_CIDRS "$_item"
    LIVESTATS_ADMIN_ALLOW="${LIVESTATS_ADMIN_ALLOW}allow ${LIVESTATS_CIDR}; "
done

# --- TLS da 8081: sem os dois secrets o web NAO sobe (nunca cai para HTTP).
for _f in /run/secrets/admin_tls_cert /run/secrets/admin_tls_key; do
    [ -s "$_f" ] || livestats_fail "secret TLS do admin ausente ou vazio: $_f (veja secrets/README.md); o web nao sobe sem HTTPS na 8081"
    [ -r "$_f" ] || livestats_fail "secret TLS do admin sem permissao de leitura para o usuario do Nginx (uid 101): $_f (veja secrets/README.md)"
done

export LIVESTATS_REALIP_PUBLIC LIVESTATS_ADMIN_ALLOW
